{
  "font": {
    "ui": "system-ui, sans-serif",
    "size_px": 16,
    "line_height": 1.5
  },
  "spacing": [
    4,
    8,
    12,
    16,
    24,
    32
  ],
  "semantic": {
    "DOCUMENTED": {
      "color": "#2563EB",
      "stroke": "solid",
      "icon": "document"
    },
    "OBSERVED": {
      "color": "#0F766E",
      "stroke": "solid",
      "icon": "quote"
    },
    "INFERRED": {
      "color": "#92400E",
      "stroke": "dash",
      "icon": "inference"
    },
    "SPECULATIVE": {
      "color": "#7E22CE",
      "stroke": "dot",
      "icon": "possibility"
    },
    "CONTRADICTION": {
      "color": "#B91C1C",
      "stroke": "fork",
      "icon": "conflict"
    },
    "RETIRED": {
      "color": "#64748B",
      "stroke": "strike",
      "icon": "history"
    }
  },
  "themes": {
    "light": {
      "background": "#F8FAFC",
      "surface": "#FFFFFF",
      "text": "#0F172A",
      "muted_text": "#475569"
    },
    "dark": {
      "background": "#0B1220",
      "surface": "#172033",
      "text": "#F1F5F9",
      "muted_text": "#CBD5E1"
    }
  },
  "note": "Semantic colors require theme-specific contrast testing; use lighter tints on dark backgrounds. Never encode meaning by color alone."
}
